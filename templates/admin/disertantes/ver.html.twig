{% extends 'base.html.twig' %}

{% block title %}
    Detalle del Disertante — {{ disertante.nombre }} {{ disertante.apellido }}
{% endblock %}

{# === SOLO CSS DE ESTA VISTA === #}
{% block stylesheets %}
    <script src="https://cdn.tailwindcss.com"></script>
{% endblock %}

{% block body %}

<div class="min-h-screen bg-slate-50 py-10 px-4 sm:px-6 lg:px-8">
    <div class="max-w-5xl mx-auto">

        {# ===== BOTÓN VOLVER ===== #}
        <a
            href="{{ path('admin_disertante_listar') }}"
            class="inline-flex items-center gap-2 text-sm font-medium text-slate-700 bg-white border border-slate-200 hover:bg-slate-100 px-4 py-2 rounded-lg transition-colors duration-150 mb-6"
        >
            {# Icono oficial: arrow-left #}
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
            </svg>
            Volver al listado
        </a>

        {# ===== CABECERA ===== #}
        <div class="mb-6 flex items-start justify-between gap-4">
            <div>
                <div class="flex items-center gap-2 mb-1">
                    {# Icono oficial: user-circle #}
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 text-emerald-600">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M17.982 18.725A7.488 7.488 0 0 0 12 15.75a7.488 7.488 0 0 0-5.982 2.975m11.963 0a9 9 0 1 0-11.963 0m11.963 0A8.966 8.966 0 0 1 12 21a8.966 8.966 0 0 1-5.982-2.275M15 9.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                    </svg>
                    <h1 class="text-2xl font-semibold text-slate-900">
                        Detalle del Disertante
                    </h1>
                </div>
                <p class="text-sm text-slate-500">
                    Información registrada de
                    <span class="font-medium text-slate-700">
                        {{ disertante.nombre }} {{ disertante.apellido }}
                    </span>
                </p>
            </div>

            <span class="hidden sm:inline-flex items-center gap-1.5 text-xs font-medium text-slate-500 bg-white border border-slate-200 px-3 py-1.5 rounded-md">
                ID #{{ disertante.id }}
            </span>
        </div>

        {# ===== GRID PRINCIPAL ===== #}
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

            {# ---------- COLUMNA IZQUIERDA (2/3): Datos + Biografía ---------- #}
            <div class="lg:col-span-2 space-y-6">

                {# Tarjeta: Datos personales #}
                <div class="bg-white border border-slate-200 rounded-xl overflow-hidden">
                    <div class="px-5 py-3 border-b border-slate-200 flex items-center gap-2">
                        {# Icono oficial: identification #}
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 text-slate-500">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 9h3.75M15 12h3.75M15 15h3.75M4.5 19.5h15a2.25 2.25 0 0 0 2.25-2.25V6.75A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25v10.5A2.25 2.25 0 0 0 4.5 19.5Zm6-10.125a1.875 1.875 0 1 1-3.75 0 1.875 1.875 0 0 1 3.75 0Zm1.294 6.336a6.721 6.721 0 0 1-3.17.789 6.721 6.721 0 0 1-3.168-.789 3.376 3.376 0 0 1 6.338 0Z" />
                        </svg>
                        <h2 class="text-sm font-semibold text-slate-800">
                            Datos personales
                        </h2>
                    </div>

                    <dl class="divide-y divide-slate-100">
                        <div class="px-5 py-3 flex items-center justify-between gap-4">
                            <dt class="text-sm text-slate-500">Nombre</dt>
                            <dd class="text-sm font-medium text-slate-800 text-right">
                                {{ disertante.nombre }}
                            </dd>
                        </div>
                        <div class="px-5 py-3 flex items-center justify-between gap-4">
                            <dt class="text-sm text-slate-500">Apellido</dt>
                            <dd class="text-sm font-medium text-slate-800 text-right">
                                {{ disertante.apellido }}
                            </dd>
                        </div>
                        <div class="px-5 py-3 flex items-center justify-between gap-4">
                            <dt class="text-sm text-slate-500">Teléfono</dt>
                            <dd class="text-sm font-medium text-slate-800 text-right">
                                {{ disertante.telefono ?: '—' }}
                            </dd>
                        </div>
                        <div class="px-5 py-3 flex items-center justify-between gap-4">
                            <dt class="text-sm text-slate-500">Email</dt>
                            <dd class="text-sm text-right">
                                {% if disertante.email %}
                                    <a
                                        href="mailto:{{ disertante.email }}"
                                        class="inline-flex items-center gap-1 text-emerald-700 hover:text-emerald-800 hover:underline font-medium"
                                    >
                                        {# Icono oficial: envelope #}
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-3.5 h-3.5">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
                                        </svg>
                                        {{ disertante.email }}
                                    </a>
                                {% else %}
                                    <span class="text-slate-400">No especificado</span>
                                {% endif %}
                            </dd>
                        </div>
                    </dl>
                </div>

                {# Tarjeta: Biografía #}
                <div class="bg-white border border-slate-200 rounded-xl overflow-hidden">
                    <div class="px-5 py-3 border-b border-slate-200 flex items-center gap-2">
                        {# Icono oficial: document-text #}
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 text-slate-500">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
                        </svg>
                        <h2 class="text-sm font-semibold text-slate-800">
                            Biografía
                        </h2>
                    </div>

                    <div class="px-5 py-4">
                        {% if disertante.biografia %}
                            <p class="text-sm text-slate-700 leading-relaxed whitespace-pre-line">
                                {{ disertante.biografia }}
                            </p>
                        {% else %}
                            <p class="text-sm text-slate-400 italic">
                                Este disertante no cuenta con biografía registrada.
                            </p>
                        {% endif %}
                    </div>
                </div>

            </div>

            {# ---------- COLUMNA DERECHA (1/3): Redes y enlaces ---------- #}
            <div class="lg:col-span-1">
                <div class="bg-white border border-slate-200 rounded-xl overflow-hidden">

                    <div class="px-5 py-3 border-b border-slate-200 flex items-center gap-2">
                        {# Icono oficial: link #}
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 text-slate-500">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244" />
                        </svg>
                        <h2 class="text-sm font-semibold text-slate-800">
                            Enlaces y redes
                        </h2>
                    </div>

                    <ul class="divide-y divide-slate-100">

                        {# Sitio web #}
                        <li class="px-5 py-3">
                            <p class="text-xs uppercase tracking-wide text-slate-400 font-medium mb-1">
                                Sitio web
                            </p>
                            {% if disertante.url %}
                                <a
                                    href="{{ disertante.url }}"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="inline-flex items-center gap-1 text-sm text-emerald-700 hover:text-emerald-800 hover:underline break-all"
                                >
                                    {{ disertante.url }}
                                    {# Icono oficial: arrow-top-right-on-square #}
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-3.5 h-3.5 shrink-0">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                                    </svg>
                                </a>
                            {% else %}
                                <p class="text-sm text-slate-400">No especificado</p>
                            {% endif %}
                        </li>

                        {# Twitter / X #}
                        <li class="px-5 py-3">
                            <p class="text-xs uppercase tracking-wide text-slate-400 font-medium mb-1">
                                Twitter / X
                            </p>
                            {% if disertante.twitter %}
                                <a
                                    href="https://twitter.com/{{ disertante.twitter|trim('@') }}"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="inline-flex items-center gap-1 text-sm text-emerald-700 hover:text-emerald-800 hover:underline"
                                >
                                    @{{ disertante.twitter|trim('@') }}
                                    {# Icono oficial: arrow-top-right-on-square #}
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-3.5 h-3.5 shrink-0">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                                    </svg>
                                </a>
                            {% else %}
                                <p class="text-sm text-slate-400">No especificado</p>
                            {% endif %}
                        </li>

                        {# LinkedIn #}
                        <li class="px-5 py-3">
                            <p class="text-xs uppercase tracking-wide text-slate-400 font-medium mb-1">
                                LinkedIn
                            </p>
                            {% if disertante.linkedin %}
                                <a
                                    href="{{ disertante.linkedin }}"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="inline-flex items-center gap-1 text-sm text-emerald-700 hover:text-emerald-800 hover:underline"
                                >
                                    Ver perfil
                                    {# Icono oficial: arrow-top-right-on-square #}
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-3.5 h-3.5 shrink-0">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                                    </svg>
                                </a>
                            {% else %}
                                <p class="text-sm text-slate-400">No especificado</p>
                            {% endif %}
                        </li>

                    </ul>
                </div>
            </div>

        </div>

        {# ===== PIE CON ACCIONES ===== #}
        <div class="mt-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
            <span class="text-xs text-slate-400">
                ID del registro: {{ disertante.id }}
            </span>

            
        </div>

    </div>
</div>

{% endblock %}