{% extends 'base.html.twig' %}

{% block header %}
<nav class="bg-white border-b border-slate-200 sticky top-0 z-40">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-14">

            {# Marca #}
            <a href="{{ path('portada') }}" class="flex items-center gap-2">
                <span class="w-8 h-8 rounded-lg bg-emerald-600 text-white flex items-center justify-center font-bold text-sm">
                    E
                </span>
                <span class="text-sm font-semibold text-slate-800">
                    Eventos
                </span>
            </a>

            {# Enlaces (desktop) #}
            <ul class="hidden md:flex items-center gap-1">
                <li>
                    <a href="{{ path('portada') }}"
                       class="text-sm font-medium text-slate-600 hover:text-emerald-700 hover:bg-emerald-50 px-3 py-1.5 rounded-md transition-colors">
                        Inicio
                    </a>
                </li>
                <li>
                    <a href="{{ path('app_eventos') }}"
                       class="text-sm font-medium text-slate-600 hover:text-emerald-700 hover:bg-emerald-50 px-3 py-1.5 rounded-md transition-colors">
                        Eventos
                    </a>
                </li>
                <li>
                    <a href="{{ path('app_disertantes') }}"
                       class="text-sm font-medium text-slate-600 hover:text-emerald-700 hover:bg-emerald-50 px-3 py-1.5 rounded-md transition-colors">
                        Disertantes
                    </a>
                </li>
            </ul>

                          <li class="ml-2 border-l border-slate-200 pl-3">
                    <a href="{{ path('app_login') }}"
                       class="inline-flex items-center gap-1.5 text-sm font-medium text-slate-700 bg-white border border-slate-200 hover:bg-slate-50 px-3 py-1.5 rounded-md transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 text-slate-500">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15M12 9l-3 3m0 0 3 3m-3-3h12.75" />
                        </svg>
                        Ingresar
                    </a>
                </li>
            </ul>

            <button
                type="button"
                id="navToggle"
                class="md:hidden inline-flex items-center justify-center w-9 h-9 rounded-md border border-slate-200 text-slate-600 hover:bg-slate-50"
                aria-label="Abrir menú"
            >
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
                </svg>
            </button>

        </div>

        {# Menú mobile #}
        <div id="navMenu" class="md:hidden hidden pb-3 space-y-1">
            <a href="{{ path('portada') }}" class="block text-sm font-medium text-slate-600 hover:bg-slate-50 px-3 py-2 rounded-md">Inicio</a>
            <a href="{{ path('app_eventos') }}" class="block text-sm font-medium text-slate-600 hover:bg-slate-50 px-3 py-2 rounded-md">Eventos</a>
            <a href="{{ path('app_disertantes') }}" class="block text-sm font-medium text-slate-600 hover:bg-slate-50 px-3 py-2 rounded-md">Disertantes</a>
        </div>
    </div>
</nav>
{% endblock %}

{% block body %}
<main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full">
    {% block contenido %}{% endblock %}
</main>

<aside class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-10 w-full">
    {% block lateral %}{% endblock %}
</aside>
{% endblock %}

{% block footer %}
<footer class="bg-white border-t border-slate-200 mt-auto">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">
            
            {# Columna Izquierda: Marca y descripción #}
            <div class="max-w-xs">
                <a href="{{ path('portada') }}" class="inline-flex items-center gap-2 mb-2">
                    <span class="w-6 h-6 rounded bg-emerald-600 text-white flex items-center justify-center font-bold text-xs">
                        E
                    </span>
                    <span class="text-sm font-semibold text-slate-800">
                        Eventos
                    </span>
                </a>
                <p class="text-xs text-slate-500 leading-relaxed">
                    Un espacio para compartir conocimientos y experiencias.
                </p>
            </div>

            {# Columna Derecha: Enlaces y Copyright #}
            <div class="flex flex-col sm:items-end gap-3">
                             <ul class="flex flex-wrap gap-x-5 gap-y-2">
                    <li>
                        <a href="{{ path('app_estatica', {'pagina': 'condiciones'}) }}" class="text-xs font-medium text-slate-500 hover:text-emerald-700 transition-colors">
                            Condiciones de uso
                        </a>
                    </li>
                    <li>
                        <a href="{{ path('app_estatica', {'pagina': 'privacidad'}) }}" class="text-xs font-medium text-slate-500 hover:text-emerald-700 transition-colors">
                            Privacidad
                        </a>
                    </li>
                    <li>
                        <a href="{{ path('app_estatica', {'pagina': 'licencia'}) }}" class="text-xs font-medium text-slate-500 hover:text-emerald-700 transition-colors">
                            Licencia
                        </a>
                    </li>
                    <li>
                        <a href="{{ path('app_estatica', {'pagina': 'patrocinadores'}) }}" class="text-xs font-medium text-slate-500 hover:text-emerald-700 transition-colors">
                            Patrocinadores
                        </a>
                    </li>
                </ul>
                <span class="text-[11px] text-slate-400">
                    © {{ "now"|date("Y") }} Eventos. Todos los derechos reservados.
                </span>
            </div>

        </div>
    </div>
</footer>
{% endblock %}

{% block javascripts %}
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const toggle = document.getElementById('navToggle');
        const menu = document.getElementById('navMenu');
        if (toggle && menu) {
            toggle.addEventListener('click', () => menu.classList.toggle('hidden'));
        }
    });
</script>
{% endblock %}