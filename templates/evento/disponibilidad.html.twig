{% extends 'frontend/layout.html.twig' %}

{% block title %}
    Disponibilidad — {{ evento.titulo }}
{% endblock %}

{% block contenido %}

<div class="max-w-2xl mx-auto">

    {# ===== BOTÓN VOLVER ===== #}
    <a href="javascript:history.back()"
       class="inline-flex items-center gap-2 text-sm font-medium text-slate-700 bg-white border border-slate-200 hover:bg-slate-100 px-4 py-2 rounded-lg transition-colors duration-150 mb-6">
        {# Icono oficial: arrow-left #}
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
        </svg>
        Volver al evento
    </a>

    {# ===== TARJETA PRINCIPAL ===== #}
    <article class="bg-white border border-slate-200 rounded-xl overflow-hidden shadow-sm">

        {# Cabecera #}
        <div class="px-6 py-5 border-b border-slate-200 bg-slate-50/50">
            <div class="flex items-center gap-1.5 text-xs font-semibold tracking-widest text-emerald-700 uppercase mb-2">
                Disponibilidad
            </div>
            <h1 class="text-2xl font-semibold text-slate-900">
                {{ evento.titulo }}
            </h1>
        </div>

        <div class="p-6 space-y-6">

            {# ===== RESULTADO DEL SERVICIO ===== #}
            <div class="
                flex items-start gap-3 rounded-xl px-5 py-4 border
                {% if tieneCupos %}
                    bg-emerald-50 border-emerald-200 text-emerald-800
                {% else %}
                    bg-red-50 border-red-200 text-red-700
                {% endif %}
            ">
                {# Iconos oficiales: check-circle / exclamation-circle #}
                {% if tieneCupos %}
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 mt-0.5 shrink-0 text-emerald-600">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                    </svg>
                {% else %}
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 mt-0.5 shrink-0 text-red-600">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" />
                    </svg>
                {% endif %}

                <div>
                    <h2 class="text-sm font-semibold">
                        {% if tieneCupos %}¡Lugares disponibles!{% else %}Sin cupos disponibles{% endif %}
                    </h2>
                    <p class="text-sm mt-1">
                        {{ mensaje }}
                    </p>
                </div>
            </div>

            {# ===== DETALLES DEL EVENTO ===== #}
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">

                {# Fecha #}
                <div class="bg-slate-50 border border-slate-200 rounded-lg p-4 flex items-start gap-3">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-emerald-600 shrink-0">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
                    </svg>
                    <div>
                        <p class="text-xs font-medium text-slate-500 uppercase tracking-wide">Fecha</p>
                        <p class="text-sm font-semibold text-slate-900 mt-0.5">{{ evento.fecha ? evento.fecha|date('d/m/Y') : 'N/D' }}</p>
                    </div>
                </div>

                {# Hora y Duración #}
                <div class="bg-slate-50 border border-slate-200 rounded-lg p-4 flex items-start gap-3">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-emerald-600 shrink-0">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                    </svg>
                    <div>
                        <p class="text-xs font-medium text-slate-500 uppercase tracking-wide">Hora</p>
                        <p class="text-sm font-semibold text-slate-900 mt-0.5">
                            {{ evento.hora ? evento.hora|date('H:i') : 'N/D' }}
                            {% if evento.duracion %}({{ evento.duracion }} min){% endif %}
                        </p>
                    </div>
                </div>

                {# Capacidad #}
                <div class="bg-slate-50 border border-slate-200 rounded-lg p-4 flex items-start gap-3">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-emerald-600 shrink-0">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z" />
                    </svg>
                    <div>
                        <p class="text-xs font-medium text-slate-500 uppercase tracking-wide">Capacidad</p>
                        <p class="text-sm font-semibold text-slate-900 mt-0.5">{{ evento.capacidad }} personas</p>
                    </div>
                </div>

                {# Estado #}
                <div class="bg-slate-50 border border-slate-200 rounded-lg p-4 flex items-start gap-3">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-emerald-600 shrink-0">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                    </svg>
                    <div>
                        <p class="text-xs font-medium text-slate-500 uppercase tracking-wide">Estado</p>
                        <p class="text-sm font-semibold text-slate-900 mt-0.5 capitalize">{{ evento.estado }}</p>
                    </div>
                </div>

            </div>

        </div>

    </article>

</div>

{% endblock %}