{% extends 'base.html.twig' %}

{% block title %}
    Disertante eliminado
{% endblock %}

{# === SOLO CSS DE ESTA VISTA === #}
{% block stylesheets %}
    <script src="https://cdn.tailwindcss.com"></script>
{% endblock %}

{% block body %}

<div class="min-h-screen bg-slate-50 py-10 px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mx-auto">

      
        <div class="bg-white border border-slate-200 rounded-xl overflow-hidden">

            <div class="px-6 py-4 border-b border-slate-200 flex items-center gap-2">
                {# Icono oficial: trash #}
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-slate-500">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                </svg>
                <h1 class="text-sm font-semibold text-slate-800">
                    Borrado de disertante
                </h1>
            </div>

            <div class="px-6 py-8 flex flex-col items-center text-center">

                {# Círculo con check #}
                <div class="w-14 h-14 rounded-full bg-emerald-50 border border-emerald-200 flex items-center justify-center mb-4">
                    {# Icono oficial: check-circle #}
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-7 h-7 text-emerald-600">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                    </svg>
                </div>

                <p class="text-slate-800 font-medium">
                    El disertante
                    <span class="font-semibold text-slate-900">
                        {{ disertante.nombre }} {{ disertante.apellido }}
                    </span>
                    ha sido borrado correctamente.
                </p>

                <p class="text-xs text-slate-500 mt-2">
                    ID del registro eliminado: #{{ disertante.id }}
                </p>

            </div>

            <div class="px-6 py-4 border-t border-slate-200 flex justify-end">
                <a
                    href="{{ path('admin_disertante_listar') }}"
                    class="inline-flex items-center justify-center gap-2 bg-emerald-600 hover:bg-emerald-700 active:bg-emerald-800 text-white text-sm font-medium px-5 py-2 rounded-lg shadow-sm transition-colors duration-150"
                >
                    {# Icono oficial: arrow-left #}
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
                    </svg>
                    Volver al listado
                </a>
            </div>

        </div>

    </div>
</div>

{% endblock %}