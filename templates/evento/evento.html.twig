
{% extends 'frontend/layout.html.twig' %}

{% block title %}Eventos{% endblock %}


{% block body %}

{% block contenido %}


{{ evento.descripcion|slice(0,150) }}
<div>
    <strong>Fecha:</strong>
    {{ evento.fecha|date('d/m/Y') }}
</div>

<div>
    <strong>Hora:</strong>
    
    {{ evento.horaFinalizacion|date('H:i') }}
</div>

<div>
    <strong>Idioma:</strong>
    {{ evento.idioma }}
</div>

<div>
    <strong>Disertante:</strong>
    <a href="{{ path('app_disertante_detalle', {'id': evento.disertante.id}) }}">
    {{ evento.disertante.nombre }}
</a>
    <br>
    {{ evento.disertante.biografia|raw }}

</div>
{% endblock %}

{% endblock %}