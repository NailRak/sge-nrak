
{% extends 'base.html.twig' %}

{% block title %}
    Gestión de Eventos
{% endblock %}

{% block body %}


<div class="pagina-eventos">
    <div class="container">

        {# Encabezado #}
        <div class="encabezado-eventos">
            <h1>Gestión de Eventos</h1>
            <p>Administrá los eventos, sus horarios, idiomas e inscripciones.</p>
        </div>

        {# Mensajes de éxito #}
        {% for mensaje in app.flashes('success') %}
            <div class="alert alert-success alert-dismissible fade show mb-4"
                 role="alert">

                <strong>¡Operación exitosa!</strong>
                {{ mensaje }}

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Cerrar">
                </button>
            </div>
        {% endfor %}

        {# Tabla de eventos #}
        <div class="tarjeta-eventos">

            <div class="table-responsive">
                <table class="table tabla-eventos">

                    <thead>
                        <tr>
                            <th>Fecha / Hora</th>
                            <th>Título</th>
                            <th>Idioma</th>
                            <th>Inscriptos</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        {% for evento in eventos %}
                            <tr>
                                <td>
                                    <span class="fecha-evento">
                                        {{ evento.fecha|date('d/m/Y') }}
                                    </span>

                                    <span class="hora-evento">
                                        🕒 {{ evento.hora|date('H:i') }} hs
                                    </span>
                                </td>

                                <td>
                                    <strong>{{ evento.titulo }}</strong>
                                </td>

                                <td>
                                    <span class="badge-idioma">
                                        {{ evento.idioma }}
                                    </span>
                                </td>

                                <td>
                                    <span class="contador-inscriptos">
                                        {{ evento.usuarios|length }}
                                    </span>
                                </td>

                                <td>
                                    {% if evento.fecha < date() %}
                                        <span class="estado-evento estado-finalizado">
                                            Finalizado
                                        </span>

                                    {% elseif evento.fecha|date('Y-m-d') == date()|date('Y-m-d') %}
                                        <span class="estado-evento estado-hoy">
                                            Activo hoy
                                        </span>

                                    {% else %}
                                        <span class="estado-evento estado-programado">
                                            Activo
                                        </span>
                                    {% endif %}
                                </td>

                                <td>
                                    <div class="acciones-evento">

                                        <a href="{{ path(
                                            'admin_evento_inscriptos',
                                            {id: evento.id}
                                        ) }}"
                                           class="btn btn-inscriptos btn-sm">
                                            👥 Inscriptos
                                        </a>

                                        <a href="{{ path(
                                            'admin_evento_borrar',
                                            {id: evento.id}
                                        ) }}"
                                           class="btn btn-borrar btn-sm">
                                            🗑️ Borrar
                                        </a>

                                    </div>
                                </td>
                            </tr>

                        {% else %}
                            <tr>
                                <td colspan="6" class="estado-vacio">
                                    <div class="mb-2">
                                        <span style="font-size: 2rem;">🌿</span>
                                    </div>

                                    <h5 class="text-success">
                                        No hay eventos registrados
                                    </h5>

                                    <p class="mb-0">
                                        Creá un nuevo evento para comenzar.
                                    </p>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>

                </table>
            </div>

            {# Pie de la tabla #}
            <div class="pie-eventos">
                <span class="text-muted small">
                    Administración y seguimiento de eventos
                </span>

                <a href="{{ path('admin_evento_nuevo') }}"
                   class="btn btn-verde">
                    ＋ Nuevo evento
                </a>
            </div>

        </div>

    </div>
</div>

{% endblock %}