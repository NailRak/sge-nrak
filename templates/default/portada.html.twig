{% extends 'frontend/layout.html.twig' %}

{% block title %}
    Eventos | Conferencias y encuentros
{% endblock %}

{% block contenido %}

<section class="bg-white border border-slate-200 rounded-2xl px-6 py-10 sm:px-10 sm:py-14 mb-8">
    <span class="inline-flex items-center gap-1.5 text-xs font-semibold tracking-widest text-emerald-700 bg-emerald-50 border border-emerald-200 px-3 py-1 rounded-full uppercase">
        Conocimiento · Innovación · Conexión
    </span>

    <h1 class="mt-5 text-3xl sm:text-4xl lg:text-5xl font-semibold tracking-tight text-slate-900 max-w-2xl">
        Descubrí nuestros eventos
    </h1>

    <p class="mt-3 text-base sm:text-lg text-slate-600 max-w-xl">
        Encontrá nuevas ideas, compartí experiencias y conectá con personas que comparten tus intereses.
    </p>

    <a href="#lista-eventos"
       class="mt-6 inline-flex items-center gap-2 bg-emerald-600 hover:bg-emerald-700 active:bg-emerald-800 text-white text-sm font-medium px-5 py-2.5 rounded-lg transition-colors duration-150">
        Explorar eventos
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5 12 21m0 0-7.5-7.5M12 21V3" />
        </svg>
    </a>
</section>

{% for mensaje in app.flashes('info') %}
    <div class="mb-4 flex items-start gap-3 bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-xl px-4 py-3">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 mt-0.5 shrink-0">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z" />
        </svg>
        <p class="text-sm">{{ mensaje }}</p>
    </div>
{% endfor %}

<div id="lista-eventos" class="mb-6">
    <span class="text-xs font-semibold tracking-widest text-emerald-700 uppercase">Agenda</span>
    <h2 class="mt-1 text-2xl font-semibold text-slate-900">Próximos eventos</h2>
    <p class="mt-1 text-sm text-slate-500">
        Explorá las actividades disponibles y encontrá tu próximo encuentro.
    </p>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">

    {% for evento in eventosCol1|merge(eventosCol2) %}

        <article class="group bg-white border border-slate-200 rounded-xl overflow-hidden hover:border-emerald-300 hover:shadow-md transition-all duration-150 flex flex-col">

            <div class="h-1
                {% if evento.fecha < date() %}bg-slate-300
                {% elseif evento.fecha|date('Y-m-d') == date()|date('Y-m-d') %}bg-emerald-500
                {% else %}bg-teal-500{% endif %}
            "></div>

            <div class="p-5 flex flex-col flex-1">

                <div class="mb-3">
                    {% if evento.fecha < date() %}
                        <span class="inline-flex items-center gap-1 text-xs font-medium text-slate-600 bg-slate-100 border border-slate-200 px-2 py-0.5 rounded-md">
                            <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span> Finalizado
                        </span>
                    {% elseif evento.fecha|date('Y-m-d') == date()|date('Y-m-d') %}
                        <span class="inline-flex items-center gap-1 text-xs font-medium text-emerald-700 bg-emerald-50 border border-emerald-200 px-2 py-0.5 rounded-md">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Activo hoy
                        </span>
                    {% else %}
                        <span class="inline-flex items-center gap-1 text-xs font-medium text-teal-700 bg-teal-50 border border-teal-200 px-2 py-0.5 rounded-md">
                            <span class="w-1.5 h-1.5 rounded-full bg-teal-500"></span> Abierto
                        </span>
                    {% endif %}
                </div>

                <h3 class="text-lg font-semibold text-slate-900 leading-snug group-hover:text-emerald-700 transition-colors duration-150">
                    <a href="{{ path('app_evento_detalle', {'slug': evento.slug}) }}">
                        {{ evento.titulo }}
                    </a>
                </h3>

                <p class="mt-2 text-sm text-slate-600 line-clamp-3">
                    {{ evento.descripcion }}
                </p>

                <ul class="mt-4 space-y-2 text-sm text-slate-600">
                    <li class="flex items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 text-slate-400 shrink-0">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
                        </svg>
                        <span>{{ evento.fecha|date('d/m/Y') }} · {{ evento.hora|date('H:i') }} hs</span>
                    </li>
                    <li class="flex items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 text-slate-400 shrink-0">
                            <path stroke-linecap="round" stroke-linejoin="round" d="m10.5 21 5.25-11.25L21 21m-9-3h7.5M3 5.621a48.474 48.474 0 0 1 6-.371m0 0c1.12 0 2.233.038 3.334.114M9 5.25V3m3.334 2.364C11.176 10.658 7.69 15.08 3 17.502m9.334-12.138c.896.061 1.785.147 2.666.257m-4.589 8.495a18.023 18.023 0 0 1-3.827-5.802" />
                        </svg>
                        <span>{{ evento.idioma }}</span>
                    </li>
                    {% if evento.disertante %}
                        <li class="flex items-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 text-slate-400 shrink-0">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M17.982 18.725A7.488 7.488 0 0 0 12 15.75a7.488 7.488 0 0 0-5.982 2.975m11.963 0a9 9 0 1 0-11.963 0m11.963 0A8.966 8.966 0 0 1 12 21a8.966 8.966 0 0 1-5.982-2.275M15 9.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                            </svg>
                            <span>{{ evento.disertante.nombre }} {{ evento.disertante.apellido }}</span>
                        </li>
                    {% endif %}
                    {% if evento.duracion %}
                        <li class="flex items-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 text-slate-400 shrink-0">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                            </svg>
                            <span>{{ evento.duracion }} min</span>
                        </li>
                    {% endif %}
                    {% if evento.capacidad > 0 %}
                        <li class="flex items-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 text-slate-400 shrink-0">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z" />
                            </svg>
                            <span>{{ evento.usuarios|length }} / {{ evento.capacidad }} inscriptos</span>
                        </li>
                    {% endif %}
                </ul>

                <div class="mt-auto pt-4 border-t border-slate-100">
                    <a href="{{ path('app_evento_detalle', {'slug': evento.slug}) }}"
                       class="inline-flex items-center gap-1.5 text-sm font-medium text-emerald-700 hover:text-emerald-800">
                        Ver detalles
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                        </svg>
                    </a>
                </div>

            </div>

        </article>

    {% else %}

        <div class="col-span-full bg-white border border-slate-200 rounded-xl px-6 py-14 text-center">
            <div class="flex flex-col items-center gap-2 text-slate-400">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
                </svg>
                <p class="text-base font-medium text-slate-600">Próximamente habrá novedades</p>
                <p class="text-sm">No hay eventos disponibles en esta sección por el momento.</p>
            </div>
        </div>

    {% endfor %}

</div>

{% endblock %}