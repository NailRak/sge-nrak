{% extends 'frontend/layout.html.twig' %}

{% block title %}
    Disertantes | Conferencistas
{% endblock %}

{% block contenido %}

{# ===== ENCABEZADO ===== #}
<div class="mb-6">
    <span class="text-xs font-semibold tracking-widest text-emerald-700 uppercase">Equipo</span>
    <h1 class="mt-1 text-2xl font-semibold text-slate-900">Nuestros disertantes</h1>
    <p class="mt-1 text-sm text-slate-500">
        Conocé a los profesionales que comparten su experiencia en nuestros eventos.
    </p>
</div>

{# ===== LISTADO DE DISERTANTES ===== #}
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">

    {% for disertante in disertantes %}

        <article class="group bg-white border border-slate-200 rounded-xl overflow-hidden hover:border-emerald-300 hover:shadow-md transition-all duration-150 flex flex-col">

            {# Cabecera del disertante #}
            <div class="p-5 border-b border-slate-100 bg-slate-50/50 flex items-start gap-4">
                {# Avatar con iniciales #}
                <div class="w-12 h-12 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold text-lg shrink-0 border border-emerald-200">
                    {{ disertante.nombre|first|upper }}{{ disertante.apellido|first|upper }}
                </div>
                <div>
                    <h2 class="text-lg font-semibold text-slate-900 leading-snug">
                        <a href="{{ path('app_disertante_detalle', {'id': disertante.id}) }}" class="hover:text-emerald-700 transition-colors">
                            {{ disertante.nombreCompleto }}
                        </a>
                    </h2>
                </div>
            </div>

            {# Cuerpo #}
            <div class="p-5 flex flex-col flex-1">

                {# Biografía corta #}
                {% if disertante.biografia %}
                    <p class="text-sm text-slate-600 line-clamp-3 mb-4">
                        {{ disertante.biografia }}
                    </p>
                {% else %}
                    <p class="text-sm text-slate-400 italic mb-4">
                        Sin biografía registrada.
                    </p>
                {% endif %}

                {# Eventos a cargo #}
                <div class="mt-auto">
                    <p class="text-xs font-semibold text-slate-500 uppercase tracking-wide mb-2 flex items-center gap-1.5">
                        {# Icono oficial: calendar #}
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 text-slate-400">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
                        </svg>
                        Imparte
                    </p>

                    <ul class="space-y-1 mb-4">
                        {% for evento in disertante.eventos %}
                            <li>
                                <a href="{{ path('app_evento_detalle', {'slug': evento.slug}) }}"
                                   class="inline-flex items-center gap-1.5 text-sm text-emerald-700 hover:text-emerald-800 hover:underline">
                                    {# Icono oficial: arrow-right #}
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5 shrink-0">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                                    </svg>
                                    <span class="line-clamp-1">{{ evento.titulo }}</span>
                                </a>
                            </li>
                        {% else %}
                            <li class="text-sm text-slate-500 italic">No imparte ningún evento.</li>
                        {% endfor %}
                    </ul>
                </div>

            </div>

            {# Pie: Redes sociales y botón #}
            <div class="px-5 py-3 border-t border-slate-100 bg-slate-50/30 flex items-center justify-between gap-2">
                
                {# Redes #}
                <div class="flex items-center gap-2">
                    {% if disertante.twitter %}
                        <a href="{{ disertante.twitter }}" target="_blank" rel="noopener noreferrer" 
                           class="text-slate-400 hover:text-emerald-600 transition-colors" title="Twitter / X">
                            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.008 5.904H5.053z"/>
                            </svg>
                        </a>
                    {% endif %}
                    
                    {% if disertante.linkedin %}
                        <a href="{{ disertante.linkedin }}" target="_blank" rel="noopener noreferrer"
                           class="text-slate-400 hover:text-emerald-600 transition-colors" title="LinkedIn">
                            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                <path fill-rule="evenodd" d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" clip-rule="evenodd"/>
                            </svg>
                        </a>
                    {% endif %}
                </div>

                {# Botón Ver Perfil #}
                <a href="{{ path('app_disertante_detalle', {'id': disertante.id}) }}"
                   class="inline-flex items-center gap-1 text-xs font-medium text-slate-700 hover:text-emerald-700 transition-colors">
                    Ver perfil
                    {# Icono oficial: arrow-right #}
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                    </svg>
                </a>

            </div>

        </article>

    {% else %}

        {# Estado vacío #}
        <div class="col-span-full bg-white border border-slate-200 rounded-xl px-6 py-14 text-center">
            <div class="flex flex-col items-center gap-2 text-slate-400">
                {# Icono oficial: users #}
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-10 h-10">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" />
                </svg>
                <p class="text-base font-medium text-slate-600">No hay disertantes disponibles</p>
                <p class="text-sm">Volvé a revisar más tarde para ver nuevas incorporaciones.</p>
            </div>
        </div>

    {% endfor %}

</div>

{% endblock %}