{% extends 'frontend/layout.html.twig' %}

{% block title %}
    Eventos | Agenda
{% endblock %}

{% block contenido %}

{# ===== ENCABEZADO ===== #}
<div class="mb-6">
    <span class="text-xs font-semibold tracking-widest text-emerald-700 uppercase">Agenda</span>
    <h1 class="mt-1 text-2xl font-semibold text-slate-900">Todos los eventos</h1>
    <p class="mt-1 text-sm text-slate-500">
        Explorá las actividades disponibles y encontrá tu próximo encuentro.
    </p>
</div>

{# ===== LISTADO DE EVENTOS ===== #}
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">

    {% for evento in eventos %}

        <article class="group bg-white border border-slate-200 rounded-xl overflow-hidden hover:border-emerald-300 hover:shadow-md transition-all duration-150 flex flex-col p-5">
            
            {# Horario #}
            <div class="flex items-center gap-1.5 text-sm font-medium text-emerald-700 mb-3">
                {# Icono oficial: clock #}
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 shrink-0">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                </svg>
                <span>
                    {{ evento.hora|date('H:i') }} – {{ evento.horaFinalizacion|date('H:i') }} hs
                </span>
            </div>

            {# Título #}
            <h3 class="text-lg font-semibold text-slate-900 leading-snug group-hover:text-emerald-700 transition-colors duration-150">
                <a href="{{ path('app_evento_detalle', {'slug': evento.slug}) }}">
                    {{ evento.titulo }}
                </a>
            </h3>

            {# Descripción (cortada a 3 líneas para que quede parejo) #}
            <p class="mt-2 text-sm text-slate-600 line-clamp-3 flex-1">
                {{ evento.descripcion }}
            </p>

            {# CTA #}
            <div class="mt-4 pt-4 border-t border-slate-100">
                <a href="{{ path('app_evento_detalle', {'slug': evento.slug}) }}"
                   class="inline-flex items-center gap-1.5 text-sm font-medium text-emerald-700 hover:text-emerald-800">
                    Ver detalles
                    {# Icono oficial: arrow-right #}
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                    </svg>
                </a>
            </div>

        </article>

    {% else %}

        {# Estado vacío #}
        <div class="col-span-full bg-white border border-slate-200 rounded-xl px-6 py-14 text-center">
            <div class="flex flex-col items-center gap-2 text-slate-400">
                {# Icono oficial: calendar #}
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
                </svg>
                <p class="text-base font-medium text-slate-600">No hay eventos disponibles</p>
                <p class="text-sm">Volvé a revisar más tarde para ver nuevas actividades.</p>
            </div>
        </div>

    {% endfor %}

</div>

{% endblock %}