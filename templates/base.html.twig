<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Eventos{% endblock %}</title>

    <script src="https://cdn.tailwindcss.com"></script>

    {% block stylesheets %}{% endblock %}
</head>
<body id="{% block pageid %}{% endblock %}" class="bg-slate-50 text-slate-800 antialiased min-h-screen flex flex-col">

<header>{% block header %}{% endblock %}</header>

<main class="flex-1">
    {% block body %}{% endblock %}
</main>

<footer>{% block footer %}{% endblock %}</footer>

{% for message in app.flashes('success') %}
    <div class="fixed top-4 right-4 z-50 max-w-sm">
        <div class="flex items-start gap-3 bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-xl px-4 py-3 shadow-lg">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 mt-0.5 shrink-0">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
            </svg>
            <p class="text-sm">{{ message }}</p>
        </div>
    </div>
{% endfor %}

{% block javascripts %}{% endblock %}

</body>
</html>