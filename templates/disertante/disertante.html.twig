{% extends 'frontend/layout.html.twig' %}

{% block title %}
    {{ disertante.nombreCompleto }} | Detalle del disertante
{% endblock %}

{% block contenido %}

<div class="max-w-4xl mx-auto">

    {# ===== BOTÓN VOLVER ===== #}
    <a href="javascript:history.back()"
       class="inline-flex items-center gap-2 text-sm font-medium text-slate-700 bg-white border border-slate-200 hover:bg-slate-100 px-4 py-2 rounded-lg transition-colors duration-150 mb-6">
        {# Icono oficial: arrow-left #}
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
        </svg>
        Volver
    </a>

    {# ===== TARJETA PRINCIPAL ===== #}
    <article class="bg-white border border-slate-200 rounded-xl overflow-hidden shadow-sm">

        {# Cabecera #}
        <div class="px-6 py-6 border-b border-slate-200 bg-slate-50/50 flex flex-col sm:flex-row items-start sm:items-center gap-5">
            
            {# Avatar con iniciales #}
            <div class="w-16 h-16 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold text-2xl shrink-0 border border-emerald-200">
                {{ disertante.nombre|first|upper }}{{ disertante.apellido|first|upper }}
            </div>
            
            <div>
                <div class="flex items-center gap-1.5 text-xs font-semibold tracking-widest text-emerald-700 uppercase mb-1">
                    Perfil del disertante
                </div>
                <h1 class="text-2xl sm:text-3xl font-semibold text-slate-900">
                    {{ disertante.nombreCompleto }}
                </h1>
            </div>
        </div>

        {# Cuerpo #}
        <div class="p-6 space-y-6">

            {# Biografía #}
            <div>
                <h2 class="text-sm font-semibold text-slate-900 mb-2 flex items-center gap-2">
                    {# Icono oficial: document-text #}
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-slate-400">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
                    </svg>
                    Biografía
                </h2>
                {% if disertante.biografia %}
                    <div class="text-sm text-slate-700 leading-relaxed bg-slate-50 border border-slate-100 rounded-lg p-4">
                        {{ disertante.biografia|raw }}
                    </div>
                {% else %}
                    <p class="text-sm text-slate-400 italic">Sin biografía registrada.</p>
                {% endif %}
            </div>

            {# Datos de contacto en Grid #}
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 border-t border-slate-200 pt-6">
                
                {# Teléfono #}
                {% if disertante.telefono %}
                    <div class="bg-white border border-slate-200 rounded-lg p-4 flex items-start gap-3">
                        {# Icono oficial: phone #}
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-emerald-600 shrink-0">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
                        </svg>
                        <div>
                            <p class="text-xs font-medium text-slate-500 uppercase tracking-wide">Teléfono</p>
                            <p class="text-sm font-semibold text-slate-900 mt-0.5">{{ disertante.telefono }}</p>
                        </div>
                    </div>
                {% endif %}

                {# Página Web #}
                {% if disertante.url %}
                    <div class="bg-white border border-slate-200 rounded-lg p-4 flex items-start gap-3">
                        {# Icono oficial: globe-alt #}
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-emerald-600 shrink-0">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm0 0a8.949 8.949 0 0 0 4.951-1.488A3.987 3.987 0 0 0 13 16h-2a3.987 3.987 0 0 0-3.951 3.512A8.949 8.949 0 0 0 12 21Zm3-11a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                        </svg>
                        <div>
                            <p class="text-xs font-medium text-slate-500 uppercase tracking-wide">Sitio Web</p>
                            <a href="{{ disertante.url }}" target="_blank" rel="noopener noreferrer" class="text-sm font-semibold text-emerald-700 hover:text-emerald-800 hover:underline mt-0.5 block truncate">
                                {{ disertante.url }}
                            </a>
                        </div>
                    </div>
                {% endif %}

            </div>

            {# Eventos a cargo #}
            <div class="border-t border-slate-200 pt-6">
                <h2 class="text-sm font-semibold text-slate-900 mb-4 flex items-center gap-2">
                    {# Icono oficial: calendar #}
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-slate-400">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
                    </svg>
                    Imparte los siguientes eventos
                </h2>

                <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    {% for evento in disertante.eventos %}
                        <li>
                            <a href="{{ path('app_evento_detalle', {'slug': evento.slug}) }}"
                               class="group flex items-center justify-between bg-white border border-slate-200 hover:border-emerald-300 hover:bg-emerald-50/30 rounded-lg p-3 transition-colors duration-150">
                                <span class="text-sm font-medium text-slate-800 group-hover:text-emerald-700">
                                    {{ evento.titulo }}
                                </span>
                                {# Icono oficial: arrow-right #}
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-slate-400 group-hover:text-emerald-600">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                                </svg>
                            </a>
                        </li>
                    {% else %}
                        <li class="col-span-full text-sm text-slate-500 italic bg-slate-50 rounded-lg p-4 border border-slate-100 text-center">
                            Este disertante no posee eventos asignados por el momento.
                        </li>
                    {% endfor %}
                </ul>
            </div>

        </div>

    </article>

</div>

{% endblock %}