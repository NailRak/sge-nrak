
{% extends 'frontend/layout.html.twig' %}

{% block title %}Eventos{% endblock %}

{% block contenido %}

{% for evento in eventos %}

    <h3>{{ evento.titulo }}</h3>
 {{ evento.titulo|title }}

{% endfor %}

{% endblock %}

{{ evento.descripcion|slice(0,150) }}
<p>{{ evento.descripcion }}</p>

<div>
    <strong>Fecha:</strong>
    {{ evento.fecha|date('d/m/Y') }}
</div>

<div>
    <strong>Hora:</strong>
    {{ evento.fecha|date('d/m/Y') }}
    -
    {{ evento.horaFinalizacion|date('H:i') }}
</div>

<div>
    <strong>Idioma:</strong>
    {{ evento.idioma }}
</div>

<div>
    <strong>Disertante:</strong>
    <a href="{{ path('app_disertantes') }}">
    {{ evento.disertante }}
    {{ disertante.biografia|raw }}
</a>
</div>
