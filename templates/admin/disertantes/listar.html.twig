
{% extends 'base.html.twig' %}

{% block title %}
    Gestión de Disertantes
{% endblock %}

{% block body %}



<div class="pagina-disertantes">
    <div class="container">
     <a href="{{ path('admin_dashboard') }}" class="btn btn-outline-success btn-sm mb-3 shadow-sm">
                <i class="fas fa-arrow-left me-1"></i> Volver al panel
            </a>
        {# Cabecera #}
        <div class="encabezado-disertantes">
            <h1>Gestión de Disertantes</h1>
            <p>Administrá los disertantes, sus datos y especialidades.</p>
        </div>

        {# Mensajes de éxito #}
        {% for mensaje in app.flashes('success') %}
            <div class="alert alert-success alert-dismissible fade show mb-4"
                 role="alert">
                <strong>¡Operación exitosa!</strong>
                {{ mensaje }}

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Cerrar">
                </button>
            </div>
        {% endfor %}

        {# Tabla de disertantes #}
        <div class="tarjeta-disertantes">

            <div class="table-responsive">
                <table class="table tabla-disertantes">

                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Apellido</th>
                            <th>Email</th>
                            <th>Especialidad</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        {% for disertante in disertantes %}
                            <tr>
                                <td>
                                    <strong>{{ disertante.nombre }}</strong>
                                </td>

                                <td>
                                    {{ disertante.apellido }}
                                </td>

                                <td>
                                    <a href="mailto:{{ disertante.email }}"
                                       class="text-decoration-none text-success">
                                        {{ disertante.email }}
                                    </a>
                                </td>

                                <td>
                                    <span class="badge-especialidad">
                                        {{ disertante.especialidad }}
                                    </span>
                                </td>

                                <td>
                                    <div class="acciones-disertante">
                                       <a href="{{ path('admin_disertante_ver', {id: disertante.id}) }}" class="btn btn-info btn-sm" title="Consultar">
                                            <i class="fas fa-eye"></i> Ver detalles
                                        </a>
                                        <a href="{{ path(
                                            'admin_disertante_editar',
                                            {id: disertante.id}
                                        ) }}"
                                           class="btn btn-editar btn-sm">
                                            ✏️ Editar
                                        </a>

                                        <a href="{{ path(
                                            'admin_disertante_borrar',
                                            {id: disertante.id}
                                        ) }}"
                                           class="btn btn-borrar btn-sm">
                                            🗑️ Borrar
                                        </a>

                                    </div>
                                </td>
                            </tr>

                        {% else %}
                            <tr>
                                <td colspan="5" class="estado-vacio">
                                    <div class="mb-2">
                                        <span style="font-size: 2rem;">🌿</span>
                                    </div>

                                    <h5 class="text-success">
                                        No hay disertantes registrados
                                    </h5>

                                    <p class="mb-0">
                                        Agregá un nuevo disertante para comenzar.
                                    </p>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>

                </table>
            </div>

            {# Pie de la tabla #}
            <div class="pie-disertantes">
                <span class="text-muted small">
                    Administración de disertantes
                </span>

                <a href="{{ path('admin_disertante_nuevo') }}"
                   class="btn btn-verde">
                    <span class="me-1">＋</span>
                    Nuevo disertante
                </a>
            </div>

        </div>

    </div>
</div>

{% endblock %}